    "Target": "Data/TriggerActions",
    "Entries": 
			{  "{{ModID}}_Add_GusSyrupMail": 
                { 
				    "ID": "{{ModID}}_Add_GusSyrupLetter",
					"Trigger": "DayEnding",
					"Condition": "PLAYER_SHIPPED_BASIC_ITEM Any {{ModID}}_NHMelon, PLAYER_FRIENDSHIP_POINTS Any Gus 1250",
					"Actions": [
						"AddMail All {{ModID}}_GusQuestMail tomorrow",
					],
				},
            
            
