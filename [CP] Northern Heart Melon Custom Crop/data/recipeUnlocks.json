                {
                    "ID": "{{ModID}}_Add_GusSyrupQuestCompleteLetter",
                    "Trigger": "DayEnding",
                    "Condition": "PLAYER_HAS_CONVERSATION_TOPIC Current questComplete_{{ModID}}_GusSyrup",
                    "Actions": [
                        "AddMail Current {{ModID}}_GusQuestCompleteMail tomorrow",
                    ]
                }
            }
},

{
    "LogName": "Add mail for Gus Syrup quest",
    "Action": "EditData",
    "Target": "data/mail",
    "Entries": {
        "{{ModID}}_GusQuestMail": "Hello @! I heard that you managed to cultivate a Northern Heart Melon. There are some pastries I would like to offer in my saloon, so could you be a dear and bring me four bottles of Heart Melon Syrup? ^ Gus%item quest {{ModID}}_GusSyrup true %%[#]Syrup needed",
   
        "{{ModID}}_GusQuestCompleteMail": "Hello @! ^ Thank you for the bottles of syrup. Attached you will find the recipe I needed them for. I will also be selling some treats made from Heart Melons at my saloon from now on! Stop by anytime! ^ Gus%item cookingRecipe {{ModID}}_HeartMelonPastry%%[#]Syrupy thanks"
    }
},


