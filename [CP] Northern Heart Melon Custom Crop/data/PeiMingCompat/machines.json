{
    "Changes": [
        {
            "LogName": "Add machine Output: Heart Melon Huangjiu - Pei Ming installed",
			"Action": "EditData",
            "When": { "HasMod: |contains=void.peiming": true},
			"Target": "Data/Machines",
			"TargetField": [
				"(BC)12",
				"OutputRules"
			],
			"Entries": {
				"{{ModId}}_HeartMelonHuangjiu": {
					"Id": "{{ModId}}_HeartMelonHuangjiu",
					"Triggers": [
						{
							"RequiredItemId": "(O){{ModID}}_NHMelon",
							"RequiredCount": 1,
                            "Condition": "PLAYER_HAS_MAIL Current void.peiming_HuangjiuLetter Received"
						},
                        	
					],
					"OutputItem": [
						{
							"ItemId": "(O){{ModID}}_HeartMelonHuangjiu",
							"ObjectInternalName": "{0} HeartMelonHuangjiu",
							"ObjectDisplayName": "Heart Melon Huangjiu",
							"PreserveId": "",
							"CopyPrice": true,
							"PriceModifiers": [
								{
									"Modification": "Multiply",
									"Amount": 7
								},
							],
							"CustomData": {
								"selph.ExtraMachineConfig.RequirementId.1": "(O)271",
								"selph.ExtraMachineConfig.RequirementCount.1": 2,
								"selph.ExtraMachineConfig.RequirementInvalidMsg": "For Huangjiu: 1 Northern Heart Melon + 2 Unmilled Rice"
							}
						}
					],
					"DaysUntilReady": 3,
	
				}
			},
			"MoveEntries": [
				{ 
                    "BeforeId": "Default_Juice",
                    "Id": "{{ModId}}_HeartMelonHuangjiu",

				}
			]
		},

		{
            "LogName": "Add machine Output: Heart Melon Syrup - without Pei Ming installed",
			"Action": "EditData",
			"Target": "Data/Machines",
			"TargetField": [
				"(BC)15",
				"OutputRules"
			],
			"Entries": {
				"{{ModId}}_HeartMelonSyrup": {
					"Id": "{{ModId}}_HeartMelonSyrup",
					"Triggers": [
						{
							"RequiredItemId": "(O){{ModID}}_NHMelon",
							"RequiredCount": 2,
                          
						},
                        	
					],
					"OutputItem": [
						{
							"ItemId": "(O){{ModID}}_HeartMelonSyrup",
							"ObjectInternalName": "{0} HeartMelonSyrup",
							"ObjectDisplayName": "{{i18n:HeartMelonSyrup.DisplayName}}",
							"PreserveId": "",
							"CopyPrice": true,
							"PriceModifiers": [
								{
									"Modification": "Multiply",
									"Amount": 2
								}
							],
								"CustomData": {
								"selph.ExtraMachineConfig.RequirementId.1": "(O)245",
								"selph.ExtraMachineConfig.RequirementCount.1": 2,
								"selph.ExtraMachineConfig.RequirementInvalidMsg": "For Heart Melon Syrup: 2 Northern Heart Melon + 1 Sugar"
							}
						}
					],
					"MinutesUntilReady": 6000
                    
					
					
				}
			},
			"MoveEntries": [
				{
					"Id": "{{ModId}}_HeartMelonSyrup",
					"BeforeId": "Default_Pickled"
				}
			]
