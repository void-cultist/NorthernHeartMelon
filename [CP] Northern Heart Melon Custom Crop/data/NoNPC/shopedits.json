{
    "Changes": [
        		{ 
            "LogName": "Make NHM seeds available for purchase",
		    "Action": "EditData",
		    "Target":  "Data/Shops",
            "When": { "HasMod: |contains=void.peiming": false },
           
            "TargetField": [
                "DesertTrade",
                "Items"
            ],
            "Entries": {
                // Add the seed item to trader's shop
                "{{ModId}}_NHMSeeds": {
                    "Id": "{{ModId}}_NHMSeeds",
                    "ItemId": "{{ModId}}_NHMSeeds",
					"TradeItemId": "(O)74",
					"TradeItemAmount": "3",
					"AvailableStock": "2",
                }
            },      
            
		},

        //recipe for love tea and glazed heart melon at night market when PM is not installed
    { 
