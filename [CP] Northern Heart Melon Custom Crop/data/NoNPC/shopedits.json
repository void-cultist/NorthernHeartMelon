                    "Price": "{{Equippable Tassel Price Token}}",
                    
                    }
                },
                "MoveEntries": [
                    {
                    "ID": "{{ModId}}_EquippableTasselRecipe",
                    "ToPosition": "Top"
                    } ]

},
