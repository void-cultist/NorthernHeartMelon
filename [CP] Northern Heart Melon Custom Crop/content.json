 {
        "LogName": "Add universally loved gift",
        "Action": "EditData",
        "Target": "Data/NPCGiftTastes",
        "TextOperations": [
        { "Operation": "Append",
          "Target": ["Entries", "Universal_Love"],
          "Value": "{{ModId}}_GlazedHeartMelon {{ModID}}_LoveTea",
          "Delimiter": " "
        },
        {   "Operation": "Append",
          "Target": ["Entries", "Universal_Like"],
          "Value": "{{ModId}}_NHMelon",
