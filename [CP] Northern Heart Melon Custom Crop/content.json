{ "Format": "2.9.0",
// NEED TRIGGER ACTIONS FOR RECIPE UNLOCK!!!!
//add config options!!!!
"ConfigSchema": {
    "Northern Heart Melon Price":
    {
        "AllowValues": "1250, 2500, 5000",
        "Default": 2500,
        "AllowBlank": false,
        "Description": "Adjust the price of the Northern Heart Melon (Crop)."
    },
    "Glazed Heart Melon Price":
    {
        "AllowValues": "3500, 5000, 7000",
        "Default": 7000,
        "AllowBlank": false,
        "Description": "Adjust the price of the Glazed Heart Melon dish."
    },
     "Love Tea Price":
    {
        "AllowValues": "5000, 10000, 15000",
        "Default": 10000,
        "AllowBlank": false,
        "Description": "Adjust the price of Love Tea (cooking recipe)."
    },
    "Heart Melon Huangjiu Price":
    {
        "AllowValues": "4000, 8000, 12000",
        "Default": 4000,
        "AllowBlank": false,
        "Description": "Adjust the price of Heart Melon Huangjiu (artisan good)."
    },
    "Giftable Tassel Price":
    {
        "AllowValues": "250000, 500000, 750000",
        "Default": 500000,
        "AllowBlank": false,
        "Description": "Adjust the cost of the Giftable Tassel recipe at the Volcano Shop. The Giftable Tassel will only be available with the NPC Pei Ming installed."
    },
    "Equippable Tassel Price":
    {
        "AllowValues": "125000, 250000, 500000",
        "Default": 500000,
        "AllowBlank": false,
        "Description": "Adjust the cost of the Equippable Tassel recipe at the Volcano Shop"
    },
    "Recipe Overrides":
    {
        "AllowValues": "true, false",
        "Default": true,
        "AllowBlank": false,
        "Description": "Change some parts of the recipes in the mod to use food categories as ingredients rather than a fixed type of item. Enables compatibility with other mods such as Cornucopia."
    },
    "Growth Time":
    {
        "AllowValues": "short, standard, long",
        "Default": "standard",
        "AllowBlank": false,
        "Description": "Change the time it takes for the Northern Heart Melon plant to grow." 

    },
    "Exclude from Shipping Collection":
    {
        "AllowValues": "true, false",
        "Default": false,
        "AllowBlank": false,
        "Description": "Whether or not you want the objects in this mod to count towards the full shipping achievement. Enable this setting to exclude the items to be counted towards that goal."
    },



},

"DynamicTokens": [
    //Growth Time

    {
        "Name": "NumberOfDays",
        "When": { "Growth Time": "standard" },
        "Value": 20 
    },
    {
        "Name": "NumberOfDays",
        "When": { "Growth Time": "short" },
        "Value": 13 
    },
    {
        "Name": "NumberOfDays",
        "When": { "Growth Time": "long" },
        "Value": 25 
    },

    //NHM Price
    {
        "Name": "Northern Heart Melon Price Token",
        "When": { "Northern Heart Melon Price": 1250 },
        "Value": 1250
    },
    {
        "Name": "Northern Heart Melon Price Token",
        "When": { "Northern Heart Melon Price": 2500 },
        "Value": 2500
    },
    {
        "Name": "Northern Heart Melon Price Token",
        "When": { "Northern Heart Melon Price": 5000 },
        "Value": 5000
    },

    //GlazedHM price
    {
        "Name": "Glazed Heart Melon Price Token",
        "When": { "Glazed Heart Melon Price": 3500 },
        "Value": 3500
    },
    {
        "Name": "Glazed Heart Melon Price Token",
        "When": { "Glazed Heart Melon Price": 5000 },
        "Value": 5000
    },
    {
        "Name": "Glazed Heart Melon Price Token",
        "When": { "Glazed Heart Melon Price": 7000 },
        "Value": 7000
    },

    //Love Tea price
     {
        "Name": "Love Tea Price Token",
        "When": { "Love Tea Price": 5000 },
        "Value": 5000
    },
    {
        "Name": "Love Tea Price Token",
        "When": { "Love Tea Price": 10000 },
        "Value": 10000
    },
    {
        "Name": "Love Tea Price Token",
        "When": { "Love Tea Price": 15000 },
        "Value": 15000
    },

    //Heart Melon Huangjiu Price
    {
        "Name": "Heart Melon Huangjiu Price Token",
        "When": { "Heart Melon Huangjiu Price": 4000 },
        "Value": 4000
    },
    {
        "Name": "Heart Melon Huangjiu Price Token",
        "When": { "Heart Melon Huangjiu Price": 8000 },
        "Value": 8000
    },
    {
        "Name": "Heart Melon Huangjiu Price Token",
        "When": { "Heart Melon Huangjiu Price": 12000 },
        "Value": 12000
    },
    
    //Giftable Tassel recipe cost
    {
        "Name": "Giftable Tassel Price Token",
        "When": { "Giftable Tassel Price": 250000 },
        "Value": 250000
    },
     {
        "Name": "Giftable Tassel Price Token",
        "When": { "Giftable Tassel Price": 500000 },
        "Value": 500000
    },
       {
        "Name": "Giftable Tassel Price Token",
        "When": { "Giftable Tassel Price": 750000 },
        "Value": 750000
    },

    //Equippable Tassel recipe cost
    {
        "Name": "Equippable Tassel Price Token",
        "When": { "Equippable Tassel Price": 125000 },
        "Value": 125000
    },
    {
        "Name": "Equippable Tassel Price Token",
        "When": { "Equippable Tassel Price": 250000 },
        "Value": 250000
    },
    {
        "Name": "Equippable Tassel Price Token",
        "When": { "Equippable Tassel Price": 500000 },
        "Value": 500000
    },
    //Pei Ming installed?
    {
        "Name": "FolderPath",
        "Value": "NoNPC",
        "When": { "HasMod: |contains=void.peiming": false }
    },
    {
        "Name": "FolderPath",
        "Value": "PeiMingCompat",
        "When": { "HasMod: |contains=void.peiming": true }
    },
    //SHipping Collection
    {
        "Name": "Shipping",
        "Value": true,
        "When": { "Exclude from Shipping Collection": true }
    },
      {
        "Name": "Shipping",
        "Value": false,
        "When": { "Exclude from Shipping Collection": false }
    },


],

"Changes": 
[

////Includes
{
    "LogName": "Include crop data",
    "Action": "Include",
    "FromFile": "data/crops.json"
},
{
    "LogName": "Include object data",
    "Action": "Include",
    "FromFile": "data/objects.json"
},
{
    "LogName": "Include cooking recipes",
    "Action": "Include",
    "FromFile": "data/cooking.json",
},
{
    "LogName": "Include crafting recipes",
    "Action": "Include",
    "FromFile": "data/crafting.json"
},
{
    "LogName": "Include machine data",
    "Action": "Include",
    "FromFile": "data/{{FolderPath}}/machines.json",
},
{
    "LogName": "Include edits to shops",
    "Action": "Include",
    "FromFile": "data/{{FolderPath}}/shopedits.json"
},
{
    "LogName": "Include recipe Unlocks",
    "Action": "Include",
    "FromFile": "data/recipeUnlocks.json"
},
{
    "LogName": "Include recipe overrides (Space Core)",
    "When": { "Recipe Overrides": true },
    "Action": "Include",
    "FromFile": "data/Overrides.json",
},
//texture load
        { 
			"LogName": "Load textures for custom crop and recipes",
            "Action": "Load",
            "Target": "{{ModId}}/objects, {{ModId}}/crops, {{ModId}}/recipes",
            "FromFile": "assets/{{TargetWithoutPath}}.png"
            
        },
  


//////buffs

{ 
    "LogName": "Add Custom Buffs",
    "Action": "EditData",
    "Target": "Data/Buffs",
    "Entries": {
        "{{ModID}}_NHMBuff": 
    {
            "DisplayName": "{{i18n:HeartMelonBuff}}",
            "Duration": -2, // This sets it to last for the entire day
            "IconTexture": "Tilesheets\\BuffsIcons",
            "IconSpriteIndex": 16, // The index within the icon texture set above. Each index is 16x16, and is read left to right, top to bottom.
            "Effects": 
        {
              "FarmingLevel": 1,
                "FishingLevel": 4,
                "ForagingLevel": 2,
                "LuckLevel": 5,
                "MiningLevel": 2,
                "CombatLevel": 3,
                "Defense": 3,
                "CritChanceMultiplier": 3,
        }
    },
       
},
},



//mail for Huangjiu without Pei Ming installed
{
    "LogName": "Add mail for Huangjiu without NPC Pei Ming installed",
    "Action": "EditData",
    "When": { 
        "HasMod: |contains=void.peiming": false,
        },
    "Target": "data/mail",
    "Entries": {
       "{{ModID}}_HuangjiuMail": "{{i18n:HuangjiuMail.text}}%item id (O){{ModID}}_NHMelon 1%%[#]{{i18n:HuangjiuMail.title}}"


}
},


{ 
    "LogName": "Trigger Action: add Huangjiu mail",
    "Action": "EditData",
     "When": { 
        "HasMod: |contains=void.peiming": false },
    "Target": "Data/TriggerActions",
    "Entries": 
			{  "{{ModID}}_Add_HuangjiuMail": 
                { 
				    "ID": "{{ModID}}_Add_HuangjiuMail",
					"Trigger": "DayEnding",
					"Condition": "PLAYER_MONEY_EARNED current 1000000",
					"Actions": [
						"AddMail Current {{ModID}}_HuangjiuMail tomorrow",
					],
				},
            }
},



